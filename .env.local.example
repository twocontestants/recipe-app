# Copy this file to .env.local and fill in your credentials

# Anthropic API key — used for "Paste recipe text" AI parsing
# Get yours from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Vercel Postgres credentials
# Get these from your Vercel dashboard after creating a Postgres database

POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NO_SSL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."
