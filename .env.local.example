# Copy this file to .env.local and fill in your credentials

# Socket.IO server URL. The realtime socket server (server.js) only runs on
# the Render deployment. Set this to your Render URL on BOTH Vercel and Render
# so every client connects to the same socket server for live sync.
# Leave blank for local dev (falls back to same-origin, where `npm run dev`
# runs server.js). NOTE: NEXT_PUBLIC_* vars are baked in at BUILD time, so a
# change here requires a redeploy/rebuild on each platform.
NEXT_PUBLIC_SOCKET_URL="https://your-app.onrender.com"

# Anthropic API key — used for "Paste recipe text" AI parsing
# Get yours from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Neon (or Vercel Postgres) connection string — used by lib/db.ts
# Get this from the Neon dashboard → Connection details → pooled connection string.
# Never commit the real value; keep it in .env.local (gitignored) and in your
# host's env vars (Render / Vercel dashboard).
POSTGRES_URL="postgresql://..."
